                    }
                    Py_XDECREF(lastRes);
                } else {
                    PyErr_Clear();
                }
            }
        }
        Py_DECREF(evalResult);
    }

    NSString *out;
    @synchronized(_capturedOutput) { out = [_capturedOutput copy]; }
    if (out.length) result[@"stdout"] = out;

    if (IsCancelled(cancellationState) && !result[@"error"]) {
        result[@"error"] = @"⏹ Annulé";
    }

    PyGILState_Release(g);
    return result;
}
