        view.backgroundColor = .systemBackground
        editorView.translatesAutoresizingMaskIntoConstraints = false
        outputView.translatesAutoresizingMaskIntoConstraints = false
        [editorView, toolbar, executeButton, stopButton, outputView, statusLabel, spinner].forEach { view.addSubview($0) }
        NSLayoutConstraint.activate([
            editorView.topAnchor.constraint(equalTo: view.safeAreaLayoutGuide.topAnchor, constant: 10),
            editorView.leadingAnchor.constraint(equalTo: view.leadingAnchor, constant: 10),
            editorView.trailingAnchor.constraint(equalTo: view.trailingAnchor, constant: -10),
            editorView.heightAnchor.constraint(equalTo: view.heightAnchor, multiplier: 0.35),
            toolbar.topAnchor.constraint(equalTo: editorView.bottomAnchor, constant: 5),
            toolbar.leadingAnchor.constraint(equalTo: view.leadingAnchor),
            toolbar.trailingAnchor.constraint(equalTo: view.trailingAnchor),
            toolbar.heightAnchor.constraint(equalToConstant: 44),
            executeButton.topAnchor.constraint(equalTo: toolbar.bottomAnchor, constant: 22),
            executeButton.centerXAnchor.constraint(equalTo: view.centerXAnchor, constant: -40),
