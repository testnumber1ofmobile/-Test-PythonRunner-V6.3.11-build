"""Inject HEADER/FRAMEWORK search paths into Debug/Release target configs only."""
import sys
from pathlib import Path

pbx_path, dev_hdr, sim_hdr = sys.argv[1:4]
lines = Path(pbx_path).read_text().splitlines(keepends=True)

HEADER_BLOCK = [
    "\t\t\t\tHEADER_SEARCH_PATHS = (\n",
    "\t\t\t\t\t\"$(inherited)\",\n",
    f"\t\t\t\t\t\"$(PROJECT_DIR)/{dev_hdr}\",\n",
    f"\t\t\t\t\t\"$(PROJECT_DIR)/{sim_hdr}\",\n",
    "\t\t\t\t);\n",
]
FRAMEWORK_BLOCK = [
    "\t\t\t\tFRAMEWORK_SEARCH_PATHS = (\n",
    "\t\t\t\t\t\"$(inherited)\",\n",
    "\t\t\t\t\t\"$(PROJECT_DIR)/Frameworks\",\n",
    "\t\t\t\t);\n",
]
LDFLAGS_BLOCK = [
    "\t\t\t\tOTHER_LDFLAGS = (\n",
    "\t\t\t\t\t\"$(inherited)\",\n",
    "\t\t\t\t\t\"-framework\",\n",
    "\t\t\t\t\tPython,\n",
    "\t\t\t\t);\n",
]


def skip_setting(i, key):
    """Advance past a setting that starts at line i (single or multi-line)."""
    text = lines[i]
    if key not in text.split("=", 1)[0]:
        return i
    # multi-line list: KEY = ( ... );
    if "(" in text and ");" not in text:
        i += 1
        while i < len(lines) and ");" not in lines[i]:
            i += 1
        return i + 1
    return i + 1


def has_framework_python(block_lines):
    blob = "".join(block_lines)
    if "-framework Python" in blob:
        return True
    # pbx typical form:
    #   "-framework",
    #   Python,
    compact = blob.replace(" ", "").replace("\t", "").replace("\n", "")
    return '"-framework",Python' in compact or '"-framework",Python,' in compact


out = []
i = 0
updated = 0
while i < len(lines):
    line = lines[i]
    if "isa = XCBuildConfiguration;" not in line:
        out.append(line)
        i += 1
        continue

    # Collect the whole configuration object (brace-matched from the line
    # that opened it — walk backwards in `out` to find '{').
    block = [line]
    i += 1
    depth = line.count("{") - line.count("}")
    # include previous lines already flushed that belong to this object
    # We started mid-object; pull back from out until the opening 'ID = {'
    prefix = []
    while out:
        prev = out.pop()
        prefix.append(prev)
        depth += prev.count("{") - prev.count("}")
        if " = {" in prev and depth > 0:
            break
        if depth <= 0:
            break
    prefix.reverse()

    while depth > 0 and i < len(lines):
        block.append(lines[i])
        depth += lines[i].count("{") - lines[i].count("}")
        i += 1

    full = prefix + block
    blob = "".join(full)
    name_is_dr = ("name = Debug;" in blob) or ("name = Release;" in blob)
    # Only mutate TARGET configs that already have INFOPLIST_FILE / PRODUCT_NAME,
    # not the project-level Debug/Release (no PRODUCT_BUNDLE_IDENTIFIER).
    is_target = "INFOPLIST_FILE" in blob or "PRODUCT_BUNDLE_IDENTIFIER" in blob

    if not (name_is_dr and is_target):
        out.extend(full)
        continue

    new_block = []
    j = 0
    seen_header = seen_fw = seen_ld = False
    while j < len(full):
        raw = full[j]
        stripped = raw.lstrip()
        if stripped.startswith("HEADER_SEARCH_PATHS"):
            if not seen_header:
                new_block.extend(HEADER_BLOCK)
                seen_header = True
            j = skip_setting(j, "HEADER_SEARCH_PATHS") if False else j
            # skip original setting
            if "(" in raw and ");" not in raw:
                j += 1
                while j < len(full) and ");" not in full[j]:
                    j += 1
                j += 1
            else:
                j += 1
            continue
        if stripped.startswith("FRAMEWORK_SEARCH_PATHS"):
            if not seen_fw:
                new_block.extend(FRAMEWORK_BLOCK)
                seen_fw = True
            if "(" in raw and ");" not in raw:
                j += 1
                while j < len(full) and ");" not in full[j]:
                    j += 1
                j += 1
            else:
                j += 1
            continue
        if stripped.startswith("OTHER_LDFLAGS"):
            if has_framework_python(full):
                new_block.append(raw)
                if "(" in raw and ");" not in raw:
                    j += 1
                    while j < len(full) and ");" not in full[j]:
                        new_block.append(full[j])
                        j += 1
                    if j < len(full):
                        new_block.append(full[j])
                        j += 1
                else:
                    j += 1
            else:
                new_block.extend(LDFLAGS_BLOCK)
                if "(" in raw and ");" not in raw:
                    j += 1
                    while j < len(full) and ");" not in full[j]:
                        j += 1
                    j += 1
                else:
                    j += 1
            seen_ld = True
            continue
        if stripped.startswith("buildSettings = {"):
            new_block.append(raw)
            j += 1
            continue
        new_block.append(raw)
        j += 1

    # Insert missing settings just after buildSettings = {
    if not seen_header or not seen_fw or not seen_ld:
        rebuilt = []
        for row in new_block:
            rebuilt.append(row)
            if "buildSettings = {" in row:
                if not seen_header:
                    rebuilt.extend(HEADER_BLOCK)
                    seen_header = True
                if not seen_fw:
                    rebuilt.extend(FRAMEWORK_BLOCK)
                    seen_fw = True
                if not seen_ld and not has_framework_python(new_block):
                    rebuilt.extend(LDFLAGS_BLOCK)
                    seen_ld = True
        new_block = rebuilt

    out.extend(new_block)
    updated += 1

Path(pbx_path).write_text("".join(out))
if updated == 0:
    print("NO_CONFIG_BLOCK", file=sys.stderr)
    sys.exit(2)
print(f"updated {updated} target XCBuildConfiguration block(s)")
PY

