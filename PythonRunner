import Foundation

/// Thread-safe cancellation flag.
/// Protocol:
///   1. beginExecution() → bump generation (ne clear PAS cancel)
///   2. if isCancelled → honor Stop, PUIS toujours acknowledgeStart() pour consommer le flag
///   3. sinon acknowledgeStart() puis travailler
/// Sans l'étape 2, un Stop resterait sticky et bloquerait les runs suivants.
@objc public final class CancellationState: NSObject {
    private let lock = NSLock()
    private var _cancelled = false
    private var _generation: UInt64 = 0

    @objc public func cancel() {
        lock.lock()
        _cancelled = true
        lock.unlock()
    }

    /// Bump generation WITHOUT clearing cancel.
    /// Check isCancelled after this; only then call acknowledgeStart(generation:).
    @objc public func beginExecution() -> UInt64 {
        lock.lock()
        _generation &+= 1
        let g = _generation
        lock.unlock()
        return g
    }

    /// Clear cancel only after we have started this generation and verified no Stop.
    @objc public func acknowledgeStart(generation gen: UInt64) {
        lock.lock()
        if _generation == gen {
            _cancelled = false
        }
        lock.unlock()
    }

    @objc public func reset() {
        lock.lock()
        _cancelled = false
        _generation &+= 1
        lock.unlock()
    }

    @objc public var isCancelled: Bool {
        lock.lock(); defer { lock.unlock() }; return _cancelled
    }

    @objc public func isCancelled(forGeneration gen: UInt64) -> Bool {
        lock.lock(); defer { lock.unlock() }
        return _cancelled && _generation == gen
    }

    @objc public var generation: UInt64 {
        lock.lock(); defer { lock.unlock() }; return _generation
    }
}
