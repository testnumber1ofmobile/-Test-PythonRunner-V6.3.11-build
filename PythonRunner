            self.editorView.setCode("1 + 2 * 3")
        })
        ac.addAction(UIAlertAction(title: "x=10 puis x", style: .default) { _ in
            self.editorView.setCode("x = 10\nx")
        })
        ac.addAction(UIAlertAction(title: "Fibonacci", style: .default) { _ in
            self.editorView.setCode("def fib(n):\n    return n if n<=1 else fib(n-1)+fib(n-2)\nfor i in range(10):\n    print(f\"F({i})={fib(i)}\")")
        })
        ac.addAction(UIAlertAction(title: "Annuler", style: .cancel))
        if let p = ac.popoverPresentationController { p.barButtonItem = toolbar.items?[2] }
        present(ac, animated: true)
    }
    @objc private func showPackages() {
        setStatus("⏳ Packages...", .systemOrange)
        DispatchQueue.global(qos: .userInitiated).async { [weak self] in
            guard let self = self else { return }
            let pkgs = self.pythonRunner.getInstalledPackages()
            let msg = pkgs.isEmpty ? "Stdlib uniquement (pas de packages tiers installés)." : pkgs.joined(separator: "\n")
            DispatchQueue.main.async {
                self.setStatus("✅ Python prêt", .systemGreen)
                let ac = UIAlertController(title: "📦 Packages présents", message: msg, preferredStyle: .actionSheet)
                ac.addAction(UIAlertAction(title: "Fermer", style: .cancel))
                if let p = ac.popoverPresentationController { p.barButtonItem = self.toolbar.items?[6] }
                self.present(ac, animated: true)
            }
        }
