static PyObject *Capture_write(PyObject *self, PyObject *args) {
    PyObject *textObj;
    if (!PyArg_ParseTuple(args, "O", &textObj)) { Py_RETURN_NONE; }
    PyObject *strObj = PyObject_Str(textObj);
    if (strObj) {
        const char *text = PyUnicode_AsUTF8(strObj);
        if (text && _capturedOutput) {
            @synchronized(_capturedOutput) { [_capturedOutput appendString:@(text)]; }
        }
        Py_DECREF(strObj);
    }
    Py_RETURN_NONE;
}
static PyObject *Capture_flush(PyObject *self, PyObject *args) { Py_RETURN_NONE; }
static PyMethodDef CaptureMethods[] = {
    {"write", Capture_write, METH_VARARGS, "write"},
    {"flush", Capture_flush, METH_VARARGS, "flush"},
    {NULL, NULL, 0, NULL}
};
static PyTypeObject CaptureType = {
    PyVarObject_HEAD_INIT(NULL, 0)
    .tp_name = "capture.Capture",
    .tp_basicsize = sizeof(PyObject),
    .tp_flags = Py_TPFLAGS_DEFAULT,
    .tp_doc = "stdout/stderr capture",
    .tp_methods = CaptureMethods,
    .tp_new = PyType_GenericNew,
};

static int _interrupt_callback(void *arg) {
    (void)arg;
    PyErr_SetString(PyExc_KeyboardInterrupt, "Interruption coopérative");
    return -1;
}
void PY_ScheduleInterrupt(void) {
    if (!_initialized) return;
    /* 0 = queued, -1 = queue full / failed — best-effort cooperative interrupt */
    if (Py_AddPendingCall(_interrupt_callback, NULL) != 0) {
        /* Fallback: set interrupt flag directly when pending-call queue is full */
        PyErr_SetInterrupt();
    }
}

static NSString *FormatException(PyObject *type, PyObject *value, PyObject *tb) {
    NSString *result = nil;
    PyObject *tbMod = PyImport_ImportModule("traceback");
    if (!tbMod) {
        if (value) {
            PyObject *eStr = PyObject_Str(value);
            if (eStr) {
                const char *txt = PyUnicode_AsUTF8(eStr);
                if (txt) result = @(txt);
                Py_DECREF(eStr);
            }
        }
        return result ?: @"Erreur Python";
    }
    PyObject *lines = tb
        ? PyObject_CallMethod(tbMod, "format_exception", "OOO", type ?: Py_None, value ?: Py_None, tb)
        : PyObject_CallMethod(tbMod, "format_exception_only", "OO", type ?: Py_None, value ?: Py_None);
    if (lines && PyList_Check(lines)) {
        PyObject *sep = PyUnicode_FromString("");
        if (sep) {
            PyObject *joined = PyObject_CallMethod(sep, "join", "O", lines);
            if (joined) {
                const char *txt = PyUnicode_AsUTF8(joined);
                if (txt) result = @(txt);
                Py_DECREF(joined);
            }
            Py_DECREF(sep);
        }
    }
    Py_XDECREF(lines);
    Py_DECREF(tbMod);
    return result ?: @"Erreur Python";
}

static BOOL IsCancelled(void *cs) {
    if (!cs) return NO;
    CancellationState *state = (__bridge CancellationState *)cs;
    return [state isCancelled];
}

static NSString *LastNonEmptyLine(const char *code) {
    NSString *s = [NSString stringWithUTF8String:code];
    if (!s) return nil;
    NSArray *lines = [s componentsSeparatedByCharactersInSet:[NSCharacterSet newlineCharacterSet]];
    for (NSInteger i = (NSInteger)lines.count - 1; i >= 0; i--) {
        NSString *line = [lines[i] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceCharacterSet]];
        if (line.length > 0 && ![line hasPrefix:@"#"]) return line;
    }
    return nil;
}

static BOOL LooksLikeCompoundStart(NSString *line) {
    static NSArray *kw;
