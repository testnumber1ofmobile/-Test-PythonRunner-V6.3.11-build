FRAMEWORKS_DIR="$SCRIPT_DIR/Frameworks"

echo "════════════════════════════════════════════════════════"
echo "  setup.sh V6.3.11 — $BEEWARE_RELEASE"
echo "════════════════════════════════════════════════════════"

for cmd in curl tar rsync python3; do
  command -v "$cmd" &>/dev/null || { echo "❌ commande manquante : $cmd"; exit 1; }
done
mkdir -p "$FRAMEWORKS_DIR"

if [ ! -f "$FRAMEWORKS_DIR/Python.xcframework/Info.plist" ]; then
  echo "📥 Téléchargement de Python-Apple-support $BEEWARE_RELEASE..."
  TMP=$(mktemp /tmp/pyios.XXXXXX.tar.gz)
  CODE=$(curl -L -o "$TMP" -w "%{http_code}" "$BEEWARE_URL")
  [ "$CODE" = "200" ] || { echo "❌ HTTP $CODE — $BEEWARE_URL"; rm -f "$TMP"; exit 1; }
  echo "📦 Extraction..."
  tar -xzf "$TMP" -C "$FRAMEWORKS_DIR/"
  rm -f "$TMP"
  [ -d "$FRAMEWORKS_DIR/Python.xcframework" ] || { echo "❌ Extraction échouée"; exit 1; }
  echo "✅ XCFramework installé"
else
  echo "✅ XCFramework déjà présent"
fi

DEV="$FRAMEWORKS_DIR/Python.xcframework/ios-arm64"
SIM="$FRAMEWORKS_DIR/Python.xcframework/ios-arm64_x86_64-simulator"

[ -d "$DEV" ] || { echo "❌ Slice device manquante : $DEV"; ls -la "$FRAMEWORKS_DIR/Python.xcframework/" || true; exit 1; }
[ -d "$SIM" ] || { echo "❌ Slice simulateur manquante : $SIM"; exit 1; }
[ -d "$DEV/lib/python$PYTHON_VER" ] || { echo "❌ PYTHONHOME device manquant"; find "$DEV" -maxdepth 3 -type d | head -30; exit 1; }
[ -d "$SIM/lib/python$PYTHON_VER" ] || { echo "❌ PYTHONHOME sim manquant"; exit 1; }

ST="$DEV/lib/python$PYTHON_VER"
for f in os.py site.py; do
  [ -f "$ST/$f" ] || { echo "❌ $f manquant dans la stdlib"; exit 1; }
done
[ -d "$ST/encodings" ] || { echo "❌ dossier encodings manquant"; exit 1; }

# ── Détection dynamique de Python.h ─────────────────────────────────────────
# BeeWare 3.11 place les headers dans slice/include/ (souvent include/Python/Python.h).
# On détecte le vrai -I, on injecte dans le pbxproj.
# Symlinks Headers/include uniquement si absents (compat HEADER_SEARCH_PATHS statiques).

find_python_h_dir() {
  local slice="$1"
  local candidates=(
    "$slice/Headers/Python.h"
    "$slice/include/Python.h"
    "$slice/Headers/Python/Python.h"
    "$slice/include/Python/Python.h"
  )
  for c in "${candidates[@]}"; do
    if [ -f "$c" ]; then
      # Retourne le dossier parent de Python.h (celui à ajouter en -I)
      dirname "$c"
      return 0
    fi
  done
  # Recherche plus large
  local found
  found=$(find "$slice" -name "Python.h" 2>/dev/null | head -1 || true)
  if [ -n "$found" ]; then
    dirname "$found"
    return 0
  fi
  return 1
}

normalize_headers() {
  local slice="$1"
  local real_dir
  real_dir=$(find_python_h_dir "$slice") || {
    echo "❌ CRITIQUE : Python.h introuvable dans $slice"
    find "$slice" -maxdepth 3 -type d 2>/dev/null | head -30 || true
    find "$slice" -name "Python.h" 2>/dev/null | head -10 || true
    exit 1
  }
  echo "✅ Header dir ($slice) : $real_dir"

  # Si Python.h est dans .../Python/, le -I doit pointer sur le parent de Python/
  # pour que #include <Python/Python.h> ou #include <Python/Python.h> marchent.
  local include_root
  if [ "$(basename "$real_dir")" = "Python" ]; then
    include_root="$(dirname "$real_dir")"
  else
    include_root="$real_dir"
  fi

  # Créer / normaliser Headers et include pour coller au HEADER_SEARCH_PATHS du pbxproj
  if [ ! -e "$slice/Headers" ]; then
    ln -sfn "$(basename "$include_root")" "$slice/Headers" 2>/dev/null || \
      ln -sfn "$include_root" "$slice/Headers"
    # Si le lien relatif est bizarre, forcer un lien absolu propre
    if [ ! -e "$slice/Headers/Python.h" ] && [ ! -e "$slice/Headers/Python/Python.h" ]; then
      rm -f "$slice/Headers"
      ln -sfn "$include_root" "$slice/Headers"
    fi
    echo "   → symlink Headers → $include_root"
  fi
  if [ ! -e "$slice/include" ]; then
    ln -sfn "$(basename "$include_root")" "$slice/include" 2>/dev/null || \
      ln -sfn "$include_root" "$slice/include"
    if [ ! -e "$slice/include/Python.h" ] && [ ! -e "$slice/include/Python/Python.h" ]; then
      rm -f "$slice/include"
      ln -sfn "$include_root" "$slice/include"
    fi
    echo "   → symlink include → $include_root"
  fi

  # Vérification finale
  if [ ! -f "$slice/Headers/Python.h" ] && [ ! -f "$slice/Headers/Python/Python.h" ] && \
     [ ! -f "$slice/include/Python.h" ] && [ ! -f "$slice/include/Python/Python.h" ]; then
    echo "❌ Impossible de normaliser les headers pour $slice"
    ls -la "$slice" || true
    exit 1
  fi
  echo "$include_root"
}

DEVICE_HEADER_ROOT=$(normalize_headers "$DEV")
SIM_HEADER_ROOT=$(normalize_headers "$SIM")

# Test de compilation optionnel (si xcrun/clang disponibles)
if command -v xcrun &>/dev/null; then
  echo "🧪 Test include Python.h..."
  TEST_C=$(mktemp /tmp/pyhdr.XXXXXX.c)
  TEST_O=$(mktemp /tmp/pyhdr.XXXXXX.o)
  cat > "$TEST_C" << 'CTEST'
#include <Python/Python.h>
int main(void) { return 0; }
CTEST
  if xcrun --sdk iphonesimulator clang -c "$TEST_C" \
      -I"$SIM/Headers" -I"$SIM/include" \
      -o "$TEST_O" 2>/tmp/pyhdr_err.txt; then
    echo "✅ Compilation test Python.h (simulateur) OK"
  else
    echo "⚠️  Compilation test a échoué (non bloquant si headers présents) :"
    cat /tmp/pyhdr_err.txt 2>/dev/null | head -20 || true
  fi
  rm -f "$TEST_C" "$TEST_O" /tmp/pyhdr_err.txt
else
  echo "ℹ️  xcrun absent — skip test compilation headers"
fi

cat > "$SCRIPT_DIR/python_paths.env" << EOF
export PYTHON_VER="$PYTHON_VER"
export DEVICE_LIB="$DEV/lib"
export SIMULATOR_LIB="$SIM/lib"
export DEVICE_SLICE="$DEV"
export SIMULATOR_SLICE="$SIM"
export DEVICE_HEADER_ROOT="$DEVICE_HEADER_ROOT"
export SIMULATOR_HEADER_ROOT="$SIM_HEADER_ROOT"
EOF
echo "✅ python_paths.env écrit"

# Inject discovered absolute header roots into project.pbxproj HEADER_SEARCH_PATHS
export PBX="$SCRIPT_DIR/PythonRunner.xcodeproj/project.pbxproj"
export DEVICE_HEADER_ROOT SIMULATOR_HEADER_ROOT
if [ -f "$PBX" ]; then
  # Remove previous injected lines if re-run
  if sed --version >/dev/null 2>&1; then
    sed -i '/\/\* setup.sh injected \*\//d' "$PBX"
  else
    sed -i '' '/\/\* setup.sh injected \*\//d' "$PBX"
  fi
  python3 - <<'PYINJECT'
import re, os, pathlib
pbx = pathlib.Path(os.environ["PBX"])
dev = os.environ["DEVICE_HEADER_ROOT"]
sim = os.environ["SIMULATOR_HEADER_ROOT"]
text = pbx.read_text()
inject = f'\n\t\t\t\t\t"{dev}", /* setup.sh injected */\n\t\t\t\t\t"{sim}", /* setup.sh injected */'
def repl(m):
    block = m.group(0)
    if "setup.sh injected" in block:
        return block
    return block.replace("HEADER_SEARCH_PATHS = (", "HEADER_SEARCH_PATHS = (" + inject, 1)
text2, n = re.subn(r"HEADER_SEARCH_PATHS = \([^;]*?\);", repl, text, flags=re.S)
pbx.write_text(text2)
print(f"✅ pbxproj HEADER_SEARCH_PATHS patched ({n} blocks)")
PYINJECT
fi

echo ""
echo "════════════════════════════════════════════════════════"
echo "  ✅ setup terminé"
echo "════════════════════════════════════════════════════════"
echo "Prochaine étape :"
echo "  open $SCRIPT_DIR/PythonRunner.xcodeproj"
echo "  → Sélectionnez votre Team de signature"
echo "  → Choisissez un simulateur ou un appareil"
echo "  → ⌘B / ⌘R"
