import Foundation

public final class ExecutionState: NSObject {
    private let lock = NSLock()
    private var _isFinished = false
    private var _token: UUID?

    public func finishIfActive(token: UUID) -> Bool {
        lock.lock()
        defer { lock.unlock() }
        guard !_isFinished, _token == token else { return false }
        _isFinished = true
        return true
    }

    public func begin(token: UUID) {
        lock.lock()
        _isFinished = false
        _token = token
        lock.unlock()
    }

    public func reset() {
        lock.lock()
        _isFinished = false
        _token = nil
        lock.unlock()
    }
}
