# ── setup.sh (Partie 1) ──────────────────────────────────────────────────────
cat > "$PROJECT_DIR/setup.sh" << 'SETUP_EOF'
#!/bin/bash
# ==============================================================================
# setup.sh — PythonRunner V6.3.11  (Partie 1)
# Compatible Bash 3.2 (macOS). Toute erreur critique → message + exit 1.
# Ne prétend PAS valider l'exécution Python sur appareil (Partie 2).
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

PROJECT_NAME="PythonRunner"
XCODEPROJ="${PROJECT_NAME}.xcodeproj"
PBXPROJ="${XCODEPROJ}/project.pbxproj"
FRAMEWORKS_DIR="Frameworks"
PYTHON_VER="3.11"
BEEWARE_RELEASE="3.11-b9"
BEEWARE_TARBALL="Python-3.11-iOS-support.b9.tar.gz"
BEEWARE_URL="https://github.com/beeware/Python-Apple-support/releases/download/${BEEWARE_RELEASE}/${BEEWARE_TARBALL}"
MIN_XCODE_MAJOR=15
ENV_FILE="python_paths.env"
REQUIRED_HEADERS="Python.h pyconfig.h pystate.h"

die() {
    echo ""
    echo "❌ ERREUR CRITIQUE : $*" >&2
    echo "   setup.sh s'arrête (exit 1)." >&2
    exit 1
}

info() { echo "   $*"; }
ok()   { echo "   ✅ $*"; }
step() {
    echo ""
    echo "──────────────────────────────────────────────────────────────"
    echo " ▶ $*"
    echo "──────────────────────────────────────────────────────────────"
}

# Test d'appartenance d'un mot dans une liste (lipo -archs : "arm64 x86_64")
has_arch() {
    local needle="$1"
    local token
    shift
    for token in $*; do
        [ "$token" = "$needle" ] && return 0
    done
    return 1
}

# ── 1. Commandes nécessaires ─────────────────────────────────────────────────
step "1/12  Commandes nécessaires"

need_cmd() {
    local c="$1"
    if ! command -v "$c" >/dev/null 2>&1; then
        die "commande manquante : $c"
    fi
    info "$(command -v "$c")"
}

need_cmd bash
need_cmd curl
need_cmd tar
need_cmd rsync
need_cmd python3
need_cmd xcodebuild
ok "toutes les commandes sont présentes"

# ── 2. Version Xcode ─────────────────────────────────────────────────────────
step "2/12  Version Xcode"

if ! xcode-select -p >/dev/null 2>&1; then
    die "aucun Developer Directory (xcode-select -p a échoué)"
fi

XCODE_VERSION_RAW="$(xcodebuild -version 2>/dev/null | awk '/Xcode/{print $2; exit}')"
[ -n "$XCODE_VERSION_RAW" ] || die "impossible de lire la version Xcode (xcodebuild -version)"

XCODE_MAJOR="${XCODE_VERSION_RAW%%.*}"
info "Xcode détecté : $XCODE_VERSION_RAW  (Developer dir : $(xcode-select -p))"

case "$XCODE_MAJOR" in
    ''|*[!0-9]*) die "version Xcode illisible : '$XCODE_VERSION_RAW'" ;;
esac
if [ "$XCODE_MAJOR" -lt "$MIN_XCODE_MAJOR" ]; then
    die "Xcode $XCODE_VERSION_RAW trop ancien (minimum requis : ${MIN_XCODE_MAJOR}.0)."
fi
ok "Xcode $XCODE_VERSION_RAW accepté (≥ ${MIN_XCODE_MAJOR}.0)"

SDK_IOS="$(xcodebuild -showsdks 2>/dev/null | awk '/iphoneos/{print $NF; exit}')"
SDK_SIM="$(xcodebuild -showsdks 2>/dev/null | awk '/iphonesimulator/{print $NF; exit}')"
[ -n "$SDK_IOS" ] || die "SDK iphoneos introuvable"
[ -n "$SDK_SIM" ] || die "SDK iphonesimulator introuvable"
info "SDK device     : $SDK_IOS"
info "SDK simulateur : $SDK_SIM"

HOST_ARCH="$(uname -m)"
info "Architecture hôte : $HOST_ARCH"

# ── 3. Téléchargement BeeWare ────────────────────────────────────────────────
step "3/12  Téléchargement BeeWare ${BEEWARE_RELEASE}"

mkdir -p "$FRAMEWORKS_DIR"
DOWNLOAD_PATH="${FRAMEWORKS_DIR}/${BEEWARE_TARBALL}"

HTTP_CODE="$(curl -L --fail --retry 3 --retry-delay 2 \
    -A "PythonRunner-setup/6.3.11" \
    -o "$DOWNLOAD_PATH" \
    -w "%{http_code}" \
    "$BEEWARE_URL" || true)"

if [ "$HTTP_CODE" != "200" ]; then
    rm -f "$DOWNLOAD_PATH"
    die "téléchargement BeeWare refusé (HTTP ${HTTP_CODE:-curl-fail}). URL : $BEEWARE_URL"
fi

[ -s "$DOWNLOAD_PATH" ] || die "archive BeeWare vide : $DOWNLOAD_PATH"

# Validation utile : l'archive doit être un tar.gz listable ET contenir Python.xcframework
if ! tar -tzf "$DOWNLOAD_PATH" >/dev/null 2>&1; then
    die "archive BeeWare illisible (tar -tzf a échoué) : $DOWNLOAD_PATH"
fi
if ! tar -tzf "$DOWNLOAD_PATH" | grep -q 'Python.xcframework/'; then
    die "archive BeeWare : Python.xcframework absent de l'inventaire tar"
fi
ok "archive HTTP 200 + tar -tzf OK (Python.xcframework présent)"

# ── 4. Extraction + slices réellement présentes ──────────────────────────────
step "4/12  Extraction et détection des slices"

EXTRACT_DIR="${FRAMEWORKS_DIR}/_extract_$$"
rm -rf "$EXTRACT_DIR"
mkdir -p "$EXTRACT_DIR"
tar -xzf "$DOWNLOAD_PATH" -C "$EXTRACT_DIR"

XCFW="$(find "$EXTRACT_DIR" -type d -name 'Python.xcframework' -print -quit)"
[ -n "$XCFW" ] && [ -d "$XCFW" ] || die "Python.xcframework introuvable après extraction"

rm -rf "${FRAMEWORKS_DIR}/Python.xcframework"
rsync -a "$XCFW/" "${FRAMEWORKS_DIR}/Python.xcframework/"
rm -rf "$EXTRACT_DIR"
XCFW="${FRAMEWORKS_DIR}/Python.xcframework"

[ -f "$XCFW/Info.plist" ] || die "Python.xcframework/Info.plist manquant"

# Bash 3.2 : PAS de mapfile. On accumule via une chaîne séparée par des sauts de ligne.
PRESENT_SLICES=""
for d in "$XCFW"/ios-*; do
    [ -d "$d" ] || continue
    PRESENT_SLICES="${PRESENT_SLICES}$(basename "$d")
"
done
[ -n "$(echo "$PRESENT_SLICES" | tr -d '[:space:]')" ] || die "aucune slice ios-* dans Python.xcframework"

info "Slices détectées :"
echo "$PRESENT_SLICES" | while IFS= read -r s; do
    [ -n "$s" ] && info "  • $s"
done

slice_exists() {
    local name="$1"
    echo "$PRESENT_SLICES" | grep -qx "$name"
}

PREFERRED_DEVICE="ios-arm64"
PREFERRED_SIM_ARM="ios-arm64-simulator"
PREFERRED_SIM_FAT="ios-arm64_x86_64-simulator"
PREFERRED_SIM_X86="ios-x86_64-simulator"

DEVICE_SLICE=""
if slice_exists "$PREFERRED_DEVICE"; then
    DEVICE_SLICE="$PREFERRED_DEVICE"
else
    while IFS= read -r s; do
        [ -z "$s" ] && continue
        case "$s" in
            *simulator*) continue ;;
            ios-arm64|ios-arm64_*) DEVICE_SLICE="$s"; break ;;
        esac
    done << EOF
$PRESENT_SLICES
EOF
fi
[ -n "$DEVICE_SLICE" ] || die "aucune slice device arm64 parmi les slices détectées"

SIMULATOR_SLICE=""
case "$HOST_ARCH" in
    arm64)
        if slice_exists "$PREFERRED_SIM_ARM"; then
            SIMULATOR_SLICE="$PREFERRED_SIM_ARM"
        elif slice_exists "$PREFERRED_SIM_FAT"; then
            SIMULATOR_SLICE="$PREFERRED_SIM_FAT"
        fi
        ;;
    x86_64)
        if slice_exists "$PREFERRED_SIM_X86"; then
            SIMULATOR_SLICE="$PREFERRED_SIM_X86"
        elif slice_exists "$PREFERRED_SIM_FAT"; then
            SIMULATOR_SLICE="$PREFERRED_SIM_FAT"
        fi
        ;;
    *)
        die "architecture hôte non supportée : $HOST_ARCH"
        ;;
esac

if [ -z "$SIMULATOR_SLICE" ]; then
    while IFS= read -r s; do
        [ -z "$s" ] && continue
        case "$s" in
            *simulator*) SIMULATOR_SLICE="$s"; break ;;
        esac
    done << EOF
$PRESENT_SLICES
EOF
fi
[ -n "$SIMULATOR_SLICE" ] || die "aucune slice simulateur compatible ($HOST_ARCH)"

ok "device     slice = $DEVICE_SLICE"
ok "simulateur slice = $SIMULATOR_SLICE  (hôte $HOST_ARCH)"

# ── 5. Architectures binaires ────────────────────────────────────────────────
step "5/12  Architectures des binaires Python"

DEVICE_FW="$XCFW/$DEVICE_SLICE/Python.framework"
SIM_FW="$XCFW/$SIMULATOR_SLICE/Python.framework"
[ -d "$DEVICE_FW" ] || die "framework device manquant : $DEVICE_FW"
[ -d "$SIM_FW"    ] || die "framework simulateur manquant : $SIM_FW"

resolve_binary() {
    local fw="$1"
    if [ -f "$fw/Python" ]; then
        echo "$fw/Python"
        return 0
    fi
    if [ -f "$fw/Versions/Current/Python" ]; then
        echo "$fw/Versions/Current/Python"
        return 0
    fi
    find "$fw" -type f -name 'Python' ! -path '*/Headers/*' | head -1
}

DEVICE_BIN="$(resolve_binary "$DEVICE_FW")"
SIM_BIN="$(resolve_binary "$SIM_FW")"
[ -n "$DEVICE_BIN" ] && [ -f "$DEVICE_BIN" ] || die "binaire Python device introuvable"
[ -n "$SIM_BIN" ] && [ -f "$SIM_BIN" ]       || die "binaire Python simulateur introuvable"

if command -v lipo >/dev/null 2>&1; then
    DEVICE_ARCHS="$(lipo -archs "$DEVICE_BIN" 2>/dev/null || true)"
    SIM_ARCHS="$(lipo -archs "$SIM_BIN" 2>/dev/null || true)"
else
    DEVICE_ARCHS="$(file -b "$DEVICE_BIN" 2>/dev/null || true)"
    SIM_ARCHS="$(file -b "$SIM_BIN" 2>/dev/null || true)"
fi
info "device     binary : $DEVICE_BIN"
info "device     archs  : $DEVICE_ARCHS"
info "simulateur binary : $SIM_BIN"
info "simulateur archs  : $SIM_ARCHS"

[ -n "$DEVICE_ARCHS" ] || die "impossible de lire les archs device"
[ -n "$SIM_ARCHS" ]    || die "impossible de lire les archs simulateur"

has_arch arm64 $DEVICE_ARCHS || die "le binaire device n'expose pas arm64 ($DEVICE_ARCHS)"

case "$HOST_ARCH" in
    arm64)
        has_arch arm64 $SIM_ARCHS || die "slice simulateur incompatible avec hôte arm64 ($SIM_ARCHS)"
