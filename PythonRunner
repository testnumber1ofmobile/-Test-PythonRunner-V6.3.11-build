            let dict = trimmed.withCString { PY_ExecuteCode($0, opaque) } as NSDictionary
            let output = (dict["stdout"] as? String) ?? ""
            let r = (dict["result"] as? String) ?? ""
            let error = dict["error"] as? String
            if cancellationState.isCancelled {
                return PythonResult(output: output, result: r, error: error ?? "⏹ Annulé")
            }
            return PythonResult(output: output, result: r, error: error)
        }
    }

    @objc public func cancelExecution() { cancellationState.cancel() }

    @objc public func resetEnvironment() {
        pythonQueue.sync {
            guard isInitialized else { return }
            PY_ResetEnvironment()
        }
    }

    @objc public func getInstalledPackages() -> [String] {
        pythonQueue.sync {
            guard isInitialized else { return [] }
            // Same generation protocol as execute — does not wipe an in-flight Stop.
            let gen = cancellationState.beginExecution()
            if cancellationState.isCancelled {
                cancellationState.acknowledgeStart(generation: gen) // consomme le cancel
                return []
            }
            cancellationState.acknowledgeStart(generation: gen)
            let code = """
            import importlib.metadata as md
            for d in sorted(md.distributions(), key=lambda x: x.name or ''):
                print(f"{d.name}=={d.version}")
            """
            let opaque = Unmanaged.passUnretained(cancellationState).toOpaque()
            let dict = code.withCString { PY_ExecuteCode($0, opaque) } as NSDictionary
            let output = (dict["stdout"] as? String) ?? ""
            return output.components(separatedBy: .newlines)
                .map { $0.trimmingCharacters(in: .whitespaces) }
                .filter { !$0.isEmpty }
        }
    }
