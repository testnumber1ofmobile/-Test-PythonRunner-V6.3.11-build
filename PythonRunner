    private func initializePython() {
        spinner.startAnimating()
        setStatus("⏳ Initialisation...", .systemOrange)
        DispatchQueue.global(qos: .userInitiated).async { [weak self] in
            guard let self = self else { return }
            let ok = self.pythonRunner.initialize()
            DispatchQueue.main.async {
                self.spinner.stopAnimating()
                if ok {
                    self.pythonReady = true
                    self.setStatus("✅ Python prêt", .systemGreen)
                    self.outputView.appendText("✅ Python initialisé\n\n")
                } else {
                    self.setStatus("❌ Erreur Python", .systemRed)
                    self.outputView.appendText("❌ Init échouée — exécutez ./setup.sh puis rebuild\n")
                }
            }
        }
    }

    @objc private func executeCode() {
        guard pythonReady else { showAlert("Erreur", "Python non initialisé"); return }
        let code = editorView.getCode().trimmingCharacters(in: .whitespacesAndNewlines)
        guard !code.isEmpty else { showAlert("Erreur", "Code vide"); return }

        let token = UUID()
        executionToken = token
        pythonRunner.executionState.begin(token: token)

        spinner.startAnimating()
        executeButton.isEnabled = false
        stopButton.isHidden = false
        setStatus("⏳ Exécution...", .systemOrange)
        outputView.appendText("\n" + String(repeating: "═", count: 50) + "\n▶ Exécution :\n")

        DispatchQueue.global(qos: .userInitiated).async { [weak self] in
            guard let self = self else { return }

            let timeoutWork = DispatchWorkItem { [weak self] in
                guard let self = self else { return }
                guard self.pythonRunner.executionState.finishIfActive(token: token) else { return }
                self.pythonRunner.cancelExecution()
                PY_ScheduleInterrupt()
                self.executionFinished(token: token, result: .init(error: "⏱ Timeout 30s (coopératif)"), fromTimeout: true)
            }
            DispatchQueue.main.asyncAfter(deadline: .now() + 30, execute: timeoutWork)

            let result = self.pythonRunner.execute(code, token: token)
            timeoutWork.cancel()
            guard self.pythonRunner.executionState.finishIfActive(token: token) else { return }
            self.executionFinished(token: token, result: result, fromTimeout: false)
        }
    }

    private func executionFinished(token: UUID, result: PythonResult, fromTimeout: Bool) {
        DispatchQueue.main.async { [weak self] in
            guard let self = self, self.executionToken == token else { return }
            self.spinner.stopAnimating()
            self.executeButton.isEnabled = true
            self.stopButton.isHidden = true
            self.executionToken = nil
            if let err = result.error {
                self.outputView.appendText("❌ \(err)\n")
                self.setStatus(fromTimeout ? "⏱ Timeout" : "❌ Erreur", .systemRed)
            } else {
                if !result.output.isEmpty { self.outputView.appendText("📤 \(result.output)") }
                if !result.result.isEmpty && result.result != "None" {
                    self.outputView.appendText("📊 \(result.result)\n")
                }
                self.setStatus("✅ Succès", .systemGreen)
            }
            self.outputView.appendText(String(repeating: "═", count: 50) + "\n")
            self.outputView.scrollToBottom()
        }
    }

    @objc private func stopExecution() {
        pythonRunner.cancelExecution()
        PY_ScheduleInterrupt()
        outputView.appendText("⏹ Annulation coopérative...\n")
    }
    @objc private func clearEditor() {
        editorView.clear(); outputView.clear(); outputView.appendText("📋 Effacé\n")
    }
    @objc private func resetEnvironment() {
        pythonRunner.resetEnvironment()
        outputView.appendText("🔄 Reset namespaces\n")
    }
    @objc private func showExamples() {
        let ac = UIAlertController(title: "📚 Exemples", message: nil, preferredStyle: .actionSheet)
        ac.addAction(UIAlertAction(title: "Hello", style: .default) { _ in
            self.editorView.setCode("print(\"Hello World !\")")
