        if (isExpr && evalResult != Py_None) {
            PyObject *repr = PyObject_Repr(evalResult);
            if (repr) {
                const char *txt = PyUnicode_AsUTF8(repr);
                if (txt) result[@"result"] = @(txt);
                Py_DECREF(repr);
            }
