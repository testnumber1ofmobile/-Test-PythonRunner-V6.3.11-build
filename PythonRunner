import Foundation

@objc(PythonResult)
public class PythonResult: NSObject {
    @objc public let output: String
    @objc public let result: String
    @objc public let error: String?
    @objc public var isSuccess: Bool { error == nil }
    @objc public init(output: String = "", result: String = "", error: String? = nil) {
        self.output = output; self.result = result; self.error = error
    }
}

@objc(PythonRunner)
public class PythonRunner: NSObject {
    @objc public static let shared = PythonRunner()
    private override init() {}
    @objc private(set) public var isInitialized = false
    private let pythonQueue = DispatchQueue(label: "com.pythonrunner.python.queue", qos: .userInitiated)
    private let cancellationState = CancellationState()
    public let executionState = ExecutionState()
    private let pythonVersion = "3.11"

    @objc public func initialize() -> Bool {
        pythonQueue.sync {
            if isInitialized { return true }
            guard let resPath = Bundle.main.resourcePath else { print("❌ no resourcePath"); return false }
            let pythonHome = "\(resPath)/python"
            let pythonLib = "\(pythonHome)/lib/python\(pythonVersion)"
            let fm = FileManager.default
            var isDir: ObjCBool = false
            guard fm.fileExists(atPath: pythonLib, isDirectory: &isDir), isDir.boolValue else {
                print("❌ Stdlib manquante: \(pythonLib)"); return false
            }
            for f in ["os.py", "site.py"] {
                guard fm.fileExists(atPath: "\(pythonLib)/\(f)") else {
                    print("❌ Manquant \(f)"); return false
                }
            }
            let ok = pythonHome.withCString { PY_Initialize($0) }
            if ok {
                isInitialized = true
                let dyn = "\(pythonLib)/lib-dynload"
                let site = "\(pythonLib)/site-packages"
                pythonLib.withCString { lib in
                    dyn.withCString { d in
                        site.withCString { s in PY_ConfigurePath(lib, d, s) }
                    }
                }
                print("✅ PYTHONHOME=\(pythonHome)")
            }
            return isInitialized
        }
    }

    @objc public func finalize() {
        /* Soft finalize: clears namespaces only; interpreter stays alive for app life. */
        pythonQueue.sync {
            guard isInitialized else { return }
            PY_Finalize()
            /* keep isInitialized == true — matches soft C finalize */
        }
    }

    public func execute(_ code: String, token: UUID? = nil) -> PythonResult {
        pythonQueue.sync {
            guard isInitialized else { return PythonResult(error: "Python non initialisé") }
            let trimmed = code.trimmingCharacters(in: .whitespacesAndNewlines)
            guard !trimmed.isEmpty else { return PythonResult(error: "Code vide") }

            // 1) Bump generation WITHOUT clearing cancel (Stop pendant la file d'attente).
            // 2) Si cancel déjà posé → honorer Stop PUIS acknowledgeStart (consommer le flag).
            //    Sans ça, Stop resterait sticky et bloquerait toutes les exécutions suivantes.
            // 3) Sinon acknowledgeStart puis exécuter.
            let gen = cancellationState.beginExecution()
            if cancellationState.isCancelled {
                cancellationState.acknowledgeStart(generation: gen) // consomme le cancel
                return PythonResult(error: "⏹ Annulé")
            }
            cancellationState.acknowledgeStart(generation: gen)

            let opaque = Unmanaged.passUnretained(cancellationState).toOpaque()
            let dict = trimmed.withCString { PY_ExecuteCode($0, opaque) } as NSDictionary
            let output = (dict["stdout"] as? String) ?? ""
            let r = (dict["result"] as? String) ?? ""
            let error = dict["error"] as? String
            if cancellationState.isCancelled {
                return PythonResult(output: output, result: r, error: error ?? "⏹ Annulé")
            }
            return PythonResult(output: output, result: r, error: error)
        }
    }

    @objc public func cancelExecution() { cancellationState.cancel() }

    @objc public func resetEnvironment() {
        pythonQueue.sync {
            guard isInitialized else { return }
            PY_ResetEnvironment()
        }
    }

    @objc public func getInstalledPackages() -> [String] {
        pythonQueue.sync {
            guard isInitialized else { return [] }
            // Same generation protocol as execute — does not wipe an in-flight Stop.
            let gen = cancellationState.beginExecution()
            if cancellationState.isCancelled {
                cancellationState.acknowledgeStart(generation: gen) // consomme le cancel
                return []
            }
            cancellationState.acknowledgeStart(generation: gen)
            let code = """
            import importlib.metadata as md
            for d in sorted(md.distributions(), key=lambda x: x.name or ''):
                print(f"{d.name}=={d.version}")
            """
            let opaque = Unmanaged.passUnretained(cancellationState).toOpaque()
            let dict = code.withCString { PY_ExecuteCode($0, opaque) } as NSDictionary
            let output = (dict["stdout"] as? String) ?? ""
            return output.components(separatedBy: .newlines)
                .map { $0.trimmingCharacters(in: .whitespaces) }
                .filter { !$0.isEmpty }
        }
    }
}
