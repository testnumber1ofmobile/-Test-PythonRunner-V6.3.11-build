    dispatch_once(&once, ^{
        kw = @[@"if",@"elif",@"else",@"for",@"while",@"try",@"except",@"finally",@"with",
               @"def",@"class",@"match",@"case",@"return",@"yield",@"raise",@"assert",
               @"import",@"from",@"global",@"nonlocal",@"pass",@"break",@"continue",@"del",@"async",@"await"];
    });
    NSString *first = nil;
    for (NSString *p in [line componentsSeparatedByCharactersInSet:[NSCharacterSet whitespaceCharacterSet]]) {
        if (p.length) { first = p; break; }
    }
    if (!first) return YES;
    if ([first hasSuffix:@":"]) first = [first substringToIndex:first.length - 1];
    return [kw containsObject:first];
}

BOOL PY_Initialize(const char *homePath) {
    /* Only _initialized means "our capture/globals are ready".
       If Py_IsInitialized() but !_initialized, a previous partial init failed —
       continue setup instead of returning YES blindly. */
    if (_initialized) return YES;

    // Une seule stratégie d'init : PyPreConfig + PyConfig (BeeWare / CPython 3.11)
    // Skip interpreter bootstrap if a previous partial init already started Python.
    if (!Py_IsInitialized()) {
        PyPreConfig preconfig;
        PyPreConfig_InitPythonConfig(&preconfig);
        preconfig.utf8_mode = 1;
        preconfig.configure_locale = 0;

        PyStatus status = Py_PreInitialize(&preconfig);
        if (PyStatus_Exception(status)) {
            return NO;
        }

        PyConfig config;
        PyConfig_InitPythonConfig(&config);
        config.write_bytecode = 0;
        config.buffered_stdio = 0;
        config.install_signal_handlers = 0;
        config.use_environment = 0;
        /* PyConfig_SetBytesString owns the conversion; PyConfig_Clear frees it. */
        status = PyConfig_SetBytesString(&config, &config.home, homePath);
        if (PyStatus_Exception(status)) {
            PyConfig_Clear(&config);
            return NO;
        }

        status = Py_InitializeFromConfig(&config);
        PyConfig_Clear(&config);
        if (PyStatus_Exception(status) || !Py_IsInitialized()) {
            return NO;
        }
    }

    _capturedOutput = [NSMutableString string];

    PyGILState_STATE g = PyGILState_Ensure();
    if (PyType_Ready(&CaptureType) < 0) {
        PyGILState_Release(g);
        /* leave interpreter up; mark as failed init */
        return NO;
    }
    PyObject *cap = PyObject_CallObject((PyObject *)&CaptureType, NULL);
    if (cap) {
        PyObject *sys = PyImport_ImportModule("sys");
        if (sys) {
            PyObject_SetAttrString(sys, "stdout", cap);
            PyObject_SetAttrString(sys, "stderr", cap);
            Py_DECREF(sys);
        }
        Py_DECREF(cap);
    }
    _globalGlobals = PyDict_New();
    _globalLocals = PyDict_New();
    if (_globalGlobals) {
        PyObject *b = PyImport_ImportModule("builtins");
        if (b) { PyDict_SetItemString(_globalGlobals, "__builtins__", b); Py_DECREF(b); }
        PyObject *n = PyUnicode_FromString("__main__");
        if (n) { PyDict_SetItemString(_globalGlobals, "__name__", n); Py_DECREF(n); }
    }
    PyGILState_Release(g);
    _initialized = YES;
    return YES;
}

void PY_Finalize(void) {
    /* Soft finalize for embedded iOS: do NOT call Py_Finalize().
       Re-init after Py_Finalize is fragile with extensions / dynload.
       We only release our own globals; interpreter stays alive for app lifetime. */
    if (!_initialized) return;
    PyGILState_STATE g = PyGILState_Ensure();
    if (_globalGlobals) { Py_DECREF(_globalGlobals); _globalGlobals = NULL; }
    if (_globalLocals) { Py_DECREF(_globalLocals); _globalLocals = NULL; }
    _capturedOutput = nil;
    PyGILState_Release(g);
    /* keep _initialized = YES so a later initialize() is a no-op */
}

void PY_ConfigurePath(const char *libPath, const char *dynloadPath, const char *sitePackagesPath) {
    if (!_initialized) return;
    PyGILState_STATE g = PyGILState_Ensure();
    PyObject *sys = PyImport_ImportModule("sys");
    if (sys) {
        PyObject *path = PyObject_GetAttrString(sys, "path");
        if (path && PyList_Check(path)) {
            PyObject *a = PyUnicode_FromString(libPath);
            PyObject *b = PyUnicode_FromString(dynloadPath);
            PyObject *c = PyUnicode_FromString(sitePackagesPath);
            if (a) { PyList_Append(path, a); Py_DECREF(a); }
            if (b) { PyList_Append(path, b); Py_DECREF(b); }
            if (c) { PyList_Append(path, c); Py_DECREF(c); }
            Py_DECREF(path);
        }
        Py_DECREF(sys);
    }
    PyGILState_Release(g);
}

void PY_ResetEnvironment(void) {
    if (!_initialized) return;
    PyGILState_STATE g = PyGILState_Ensure();

    /* Safe reset: only rebuild __main__ namespaces.
       Do NOT purge sys.modules — that can break stdlib / extension state. */
    PyObject *oldOut = NULL, *oldErr = NULL;
    PyObject *sys = PyImport_ImportModule("sys");
    if (sys) {
        oldOut = PyObject_GetAttrString(sys, "stdout");
        oldErr = PyObject_GetAttrString(sys, "stderr");
        Py_DECREF(sys);
    }

    if (_globalGlobals) { Py_DECREF(_globalGlobals); _globalGlobals = NULL; }
    if (_globalLocals)  { Py_DECREF(_globalLocals);  _globalLocals  = NULL; }

    _globalGlobals = PyDict_New();
    _globalLocals  = PyDict_New();
    if (_globalGlobals) {
        PyObject *b = PyImport_ImportModule("builtins");
        if (b) { PyDict_SetItemString(_globalGlobals, "__builtins__", b); Py_DECREF(b); }
        PyObject *n = PyUnicode_FromString("__main__");
        if (n) { PyDict_SetItemString(_globalGlobals, "__name__", n); Py_DECREF(n); }
    }

    if (oldOut || oldErr) {
        PyObject *sys2 = PyImport_ImportModule("sys");
        if (sys2) {
            if (oldOut) PyObject_SetAttrString(sys2, "stdout", oldOut);
            if (oldErr) PyObject_SetAttrString(sys2, "stderr", oldErr);
            Py_DECREF(sys2);
        }
    }
    Py_XDECREF(oldOut);
    Py_XDECREF(oldErr);
    PyGILState_Release(g);
}

NSDictionary *PY_ExecuteCode(const char *code, void *cancellationState) {
    if (!_initialized || !Py_IsInitialized()) {
        return @{@"error": @"Python non initialisé"};
    }
    @synchronized(_capturedOutput) { [_capturedOutput setString:@""]; }
    NSMutableDictionary *result = [NSMutableDictionary dictionary];
    PyGILState_STATE g = PyGILState_Ensure();

    if (IsCancelled(cancellationState)) {
        result[@"error"] = @"Annulé avant compile";
        PyGILState_Release(g);
        return result;
    }

    PyObject *codeObj = Py_CompileString(code, "<string>", Py_eval_input);
    BOOL isExpr = (codeObj != NULL);
    if (!codeObj) {
        PyErr_Clear();
        codeObj = Py_CompileString(code, "<string>", Py_file_input);
    }
    if (!codeObj) {
        PyObject *t = NULL, *v = NULL, *tb = NULL;
        PyErr_Fetch(&t, &v, &tb);
        result[@"error"] = FormatException(t, v, tb);
        Py_XDECREF(t); Py_XDECREF(v); Py_XDECREF(tb);
        PyGILState_Release(g);
        return result;
    }

    if (IsCancelled(cancellationState)) {
        Py_DECREF(codeObj);
        result[@"error"] = @"Annulé avant eval";
        PyGILState_Release(g);
        return result;
    }

    PyObject *ret = PyEval_EvalCode(codeObj, _globalGlobals, _globalLocals);
    Py_DECREF(codeObj);

    if (ret) {
        if (isExpr && ret != Py_None) {
            PyObject *r = PyObject_Repr(ret);
            if (r) {
                const char *t = PyUnicode_AsUTF8(r);
                if (t) result[@"result"] = @(t);
                Py_DECREF(r);
            }
        }
        Py_DECREF(ret);

        /* last-line uniquement si multi-lignes */
        if (!isExpr && !result[@"result"]) {
            NSString *full = [[NSString stringWithUTF8String:code]
                stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
            NSString *last = LastNonEmptyLine(code);
            BOOL multiLine = (last.length > 0 && full.length > 0 && ![full isEqualToString:last]);

            if (multiLine && !LooksLikeCompoundStart(last)) {
                PyObject *ec = Py_CompileString(last.UTF8String, "<string>", Py_eval_input);
                if (ec) {
                    PyObject *er = PyEval_EvalCode(ec, _globalGlobals, _globalLocals);
                    Py_DECREF(ec);
                    if (er) {
                        if (er != Py_None) {
                            PyObject *r = PyObject_Repr(er);
                            if (r) {
                                const char *t = PyUnicode_AsUTF8(r);
                                if (t) result[@"result"] = @(t);
                                Py_DECREF(r);
                            }
                        }
                        Py_DECREF(er);
                    } else {
                        PyErr_Clear();
                    }
                } else {
                    PyErr_Clear();
                }
            }
        }
    } else {
        PyObject *t = NULL, *v = NULL, *tb = NULL;
        PyErr_Fetch(&t, &v, &tb);
        PyErr_NormalizeException(&t, &v, &tb);
        if (t && PyErr_GivenExceptionMatches(t, PyExc_KeyboardInterrupt)) {
            result[@"error"] = @"⏹ Interruption coopérative";
        } else {
            result[@"error"] = FormatException(t, v, tb);
        }
        Py_XDECREF(t); Py_XDECREF(v); Py_XDECREF(tb);
    }

    PyGILState_Release(g);

    @synchronized(_capturedOutput) {
        if (_capturedOutput.length) result[@"stdout"] = [_capturedOutput copy];
    }
    if (!result[@"stdout"] && !result[@"error"] && !result[@"result"]) {
        result[@"result"] = @"None";
    }
    return result;
}
